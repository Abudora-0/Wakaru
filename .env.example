# Wakaru runs with none of these set. Every one of them is optional.

# Self hosted LibreTranslate. When this is set the provider chain puts it
# first, which removes the daily quota and the third party entirely.
#   docker compose -f docker/libretranslate.yml up -d
# LIBRETRANSLATE_URL=http://localhost:5000

# Only needed by a hosted LibreTranslate instance. A self hosted one needs no key.
# LIBRETRANSLATE_API_KEY=

# MyMemory allows 5,000 characters a day anonymously. Supplying an email
# raises that to 50,000. It is sent to MyMemory and nowhere else.
# MYMEMORY_EMAIL=you@example.com

# The undocumented Google endpoint. Off by default, and it should stay off
# unless you have decided the trade off is acceptable for your deployment:
# it is keyless and high quality, but it is undocumented, rate limited by IP
# and not covered by any published terms for this use.
# WAKARU_ENABLE_GTX=false
