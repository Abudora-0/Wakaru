{
  "name": "@wakaru/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Wakaru browser extension. Reads raw manga and manhwa pages in place and overlays the translation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wakaru/core": "*",
    "@wakaru/ocr": "*",
    "@wakaru/tokens": "*"
  },
  "devDependencies": {
    "wxt": "^0.21.4"
  }
}
